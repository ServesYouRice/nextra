{
  "name": "nextra",
  "private": true,
  "version": "2.0.1",
  "description": "Self-hosted low-latency screen sharing with browser capture, OBS WHIP ingest, mediasoup, and relay fallback.",
  "license": "GPL-3.0-only",
  "author": "ServesYouRice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ServesYouRice/nextra.git"
  },
  "bugs": {
    "url": "https://github.com/ServesYouRice/nextra/issues"
  },
  "homepage": "https://github.com/ServesYouRice/nextra#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:client": "vite",
    "dev:server": "node server.js --dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.lifecycle.json",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:coverage": "node scripts/coverage-gate.js",
    "package": "npm run release:prep && node scripts/package-app.js",
    "package:artifact": "node scripts/package-app.js",
    "oss:check": "node scripts/opensource-preflight.js",
    "audit:prod": "npm audit --omit=dev && npm --prefix poc-mediasoup audit --omit=dev",
    "benchmark:runtime": "node scripts/benchmark-runtime.js",
    "churn:runtime": "node scripts/churn-runtime.js",
    "evaluate:packaging": "node scripts/evaluate-packaging.js",
    "release:prep": "npm run lint && npm run typecheck && npm test && npm run test:coverage && npm run build && npm run evaluate:packaging && npm run oss:check && npm run audit:prod"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "mediasoup": "^3.21.0",
    "selfsigned": "^5.5.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "caxa": "^3.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "mediasoup-client": "^3.18.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rcedit": "^5.0.2",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "ws": "^8.21.1"
  },
  "overrides": {
    "minimatch": "3.1.4"
  }
}
