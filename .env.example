# Nextra configuration - copy to .env and edit as needed

# Server
PORT=3000
BIND_HOST=127.0.0.1
OPEN_BROWSER=false
LOCAL_HTTPS=false
HTTPS_CERT_DIR=./certs
HTTPS_INCLUDE_LAN_IP_IN_CERT=false

# Network discovery
# LAN_IP=192.168.1.50
# PUBLIC_IP=203.0.113.50
AUTO_DETECT_PUBLIC_IP=false

# Public sharing
# Packaged Nextra.exe enables AUTO_PUBLIC_TUNNEL by default for end users.
# SHARE_BASE_URL=https://your-public-domain.example.com
AUTO_PUBLIC_TUNNEL=false
PUBLIC_TUNNEL_PROVIDER=cloudflared
# CLOUDFLARED_PATH=cloudflared.exe
# Stable named tunnel: set its token and SHARE_BASE_URL; its ingress must target Nextra.
# CLOUDFLARED_TUNNEL_TOKEN=your-tunnel-token
# ALLOW_SYSTEM_CLOUDFLARED=1
PUBLIC_TUNNEL_NO_TLS_VERIFY=true
PUBLIC_TUNNEL_TIMEOUT_MS=20000
TRUST_PROXY=false
TRUST_X_FORWARDED_HEADERS=false
ALLOW_TRYCLOUDFLARE_ORIGINS=false
ALLOW_SOCKET_NO_ORIGIN=false
EXPOSE_LAN_URL=false
# EXTRA_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Mediasoup transport ports
RTC_MIN_PORT=40000
RTC_MAX_PORT=40099
# Set RTC_LISTEN_IP=0.0.0.0 only when the media plane should accept LAN/public traffic.
# RTC_LISTEN_IP=0.0.0.0
MEDIASOUP_LOG_LEVEL=warn

# Room and reconnect behavior
MAX_VIEWERS_PER_ROOM=10
MAX_ACTIVE_ROOMS=10
ROOM_STALE_TIMEOUT_MS=600000
# How long viewers wait for a disconnected host to reclaim the room (page
# reload reclaims within seconds; longer values leave viewers on a frozen frame).
HOST_RECONNECT_GRACE_MS=30000

# Rate limits and socket safety
CREATE_ROOM_RATE_LIMIT_MAX=10
CREATE_ROOM_RATE_LIMIT_WINDOW_MS=60000
JOIN_RATE_LIMIT_MAX=20
JOIN_RATE_LIMIT_WINDOW_MS=60000
MAX_CONNECTIONS_PER_IP=60
CONNECTION_WINDOW_MS=60000
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=60000
SOCKET_MAX_HTTP_BUFFER_SIZE=8388608
MEDIA_MAX_CHUNK_SIZE=4194304
MEDIA_TOGGLE_VIEWER_COOLDOWN_MS=3000

# Relay behavior
HOST_UPLOAD_MBPS=36
RELAY_FLUSH_INTERVAL_MS=300
RELAY_VIDEO_BITS_PER_SECOND=45000000
# Per-viewer socket send-buffer cap before a slow relay viewer is skipped/kicked.
RELAY_SOCKET_MAX_BUFFERED_BYTES=16777216
METRICS_BROADCAST_INTERVAL_MS=5000
ALLOW_REMOTE_MEDIA_CONTROL=false
ALLOW_REMOTE_METRICS=false
# METRICS_TOKEN=replace-with-long-random-token
# Opt-in Prometheus/OpenMetrics endpoint at /metrics. METRICS_TOKEN is mandatory.
ENABLE_OPENMETRICS=false
LOG_LEVEL=info
# LOG_FORMAT=json
MEDIA_DEBUG_LOGS=false

# OBS / WHIP ingest
WHIP_ENABLED=true
WHIP_HTTP_PORT=3001
WHIP_BIND_HOST=127.0.0.1
# Required to bind the plaintext OBS-compatible listener beyond loopback.
# Only enable behind an encrypted VPN or TLS reverse proxy.
WHIP_ALLOW_INSECURE_REMOTE=0
# FFMPEG_PATH=ffmpeg
FALLBACK_FRAGMENT_DURATION_MS=500
FALLBACK_AUDIO_BITRATE=192k
# Relay A/V sync: how much to delay OBS audio (ms) to match video. Video gains
# real latency from re-encode + 1s-GOP fragmentation that audio doesn't, so a
# delay is needed. If audio plays AHEAD of the lips, raise it; if BEHIND, lower it.
FALLBACK_AUDIO_OFFSET_MS=1500
MAX_FALLBACK_VIEWERS=50
MAX_FALLBACK_PIPELINES=2
FALLBACK_RESTART_CAP=5

# WHEP viewer egress (standards-based HTTP viewer endpoint)
WHEP_ENABLED=false
WHEP_RATE_LIMIT_MAX=5
WHEP_RATE_LIMIT_WINDOW_MS=60000
WHEP_MAX_GLOBAL_SESSIONS=30

# TURN server (for strict NAT/firewall environments)
# Supports multiple URLs separated by comma
# TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
# TURN_SECRET=myHMACsecret
# TURN_USERNAME=myUser
# TURN_CREDENTIAL=myPassword

# Cloudflare TURN autofill for the AV1 BYOK modal
# Server-only values. The browser never sees the long-lived API token.
# CLOUDFLARE_TURN_KEY_ID=your_turn_key_id
# CLOUDFLARE_TURN_API_TOKEN=your_turn_key_token
# CLOUDFLARE_TURN_TTL_SECONDS=21600
