# P2Pvideo configuration - copy to .env and edit as needed

# Server
PORT=3000
BIND_HOST=127.0.0.1
HTTPS_CERT_DIR=./certs
HTTPS_INCLUDE_LAN_IP_IN_CERT=false

# Network discovery
# LAN_IP=192.168.1.50
# PUBLIC_IP=203.0.113.50
AUTO_DETECT_PUBLIC_IP=false

# Public sharing
# SHARE_BASE_URL=https://your-public-domain.example.com
AUTO_PUBLIC_TUNNEL=true
PUBLIC_TUNNEL_PROVIDER=cloudflared
# CLOUDFLARED_PATH=cloudflared.exe
PUBLIC_TUNNEL_NO_TLS_VERIFY=true
PUBLIC_TUNNEL_TIMEOUT_MS=20000
TRUST_PROXY=false
TRUST_X_FORWARDED_HEADERS=false
ALLOW_TRYCLOUDFLARE_ORIGINS=false
ALLOW_SOCKET_NO_ORIGIN=false
EXPOSE_LAN_URL=false
# EXTRA_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Mediasoup transport ports
RTC_MIN_PORT=40000
RTC_MAX_PORT=40099
# RTC_LISTEN_IP=0.0.0.0
MEDIASOUP_LOG_LEVEL=warn

# Room and reconnect behavior
MAX_VIEWERS_PER_ROOM=20
ROOM_STALE_TIMEOUT_MS=600000
HOST_RECONNECT_GRACE_MS=300000

# Rate limits and socket safety
MAX_CONNECTIONS_PER_IP=60
CONNECTION_WINDOW_MS=60000
SOCKET_MAX_HTTP_BUFFER_SIZE=8388608
MEDIA_MAX_CHUNK_SIZE=4194304

# Relay behavior
HOST_UPLOAD_MBPS=20
RELAY_FLUSH_INTERVAL_MS=300
RELAY_VIDEO_BITS_PER_SECOND=2500000
METRICS_BROADCAST_INTERVAL_MS=5000
ALLOW_REMOTE_METRICS=false

# TURN server (for strict NAT/firewall environments)
# Supports multiple URLs separated by comma
# TURN_URL=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
# TURN_SECRET=myHMACsecret
# TURN_USERNAME=myUser
# TURN_CREDENTIAL=myPassword
